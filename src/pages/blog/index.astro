---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title="Devlog" description="Every devlog entry, newest first.">
  <h1>Devlog</h1>
  <p class="muted">Decisions, things that broke, and what the AI agents did (and got wrong).</p>
  {posts.length === 0 ? (
    <p class="empty">Nothing here yet. The first entry is on its way.</p>
  ) : (
    <ul class="posts">
      {posts.map((p) => (
        <li>
          <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
          <a href={`/blog/${p.id}/`}>{p.data.title}</a>
          <div class="muted">{p.data.description}</div>
        </li>
      ))}
    </ul>
  )}
</Base>
