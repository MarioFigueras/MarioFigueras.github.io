---
import Base from '../layouts/Base.astro';
import Diorama from '../components/Diorama.astro';
import Entry from '../components/Entry.astro';
import NowTerminal from '../components/NowTerminal.astro';
import { posts, upcoming, entryNumber, pad2 } from '../lib/site';

const all = await posts();
const latest = all.slice(0, 5);
const nx = await upcoming();
const issue = pad2(Math.max(0, ...all.map(entryNumber), nx?.n ?? 0));
const month = new Date().toISOString().slice(0, 7).replace('-', '.');

const projects = [
  { name: 'NihonWorld', state: 'grey boxes', text: 'A Japanese tutor you play. Plain code decides what you learn; an LLM only plays a part in the scene.' },
  { name: 'Generator', state: 'splitting out', text: "Makes NihonWorld's content. It proposes, a human reviews, and only approved content reaches the game." },
  { name: 'Agent Hub', state: 'running', text: 'How Claude, ChatGPT and Codex work on the same project: they audit each other, I approve.' },
];
---

<Base>
  <section class="mast">
    <div>
      <div class="chips t-dot"><span class="b">No.{issue}</span><span>{month}</span><span>ONE HUMAN · THREE AIS</span></div>
      <h1 class="logo"><span class="word">DEV<br />LOG</span><span class="kana" lang="ja" aria-label="開発日誌">{[...'開発日誌'].map((c) => <span aria-hidden="true">{c}</span>)}</span><span class="visually-hidden">Mario Figueras's devlog</span></h1>
      <p class="who">Mario Figueras builds <em>a Japanese tutor you play</em>, one diorama at a time.</p>
      <p class="intro">
        I'm building <strong>NihonWorld</strong> together with three AI assistants that check each other's work. My day job
        is Jira administration. This is where I write down what actually happened, mistakes included.
      </p>
    </div>
    <Diorama name="lab" jp="研究室" en="the lab" note="Ivliss Lab · three AIs, one human" size="hero" />
  </section>

  <div class="cols">
    <section>
      {nx && (
        <>
          <h2 class="sec t-dot">NEXT TRANSMISSION</h2>
          <div class="next">
            <span class="when">{nx.date.slice(5).replace('-', '.')}</span>
            <div><span class="t-dot">DEVLOG No.{pad2(nx.n)} · {nx.key}</span><h3>{nx.title}</h3></div>
          </div>
        </>
      )}
      <h2 class="sec t-dot">ARCHIVE</h2>
      {latest.map((p) => <Entry post={p} />)}
      {all.length > latest.length && <p class="back t-dot"><a href="/blog/">ALL ENTRIES ▸</a></p>}
    </section>
    <aside>
      <NowTerminal />
      <div class="desk">
        <h2 class="sec t-dot">ON THE DESK</h2>
        {projects.map((p) => (
          <div class="proj"><span class="state t-dot">{p.state}</span><b>{p.name}</b><p>{p.text}</p></div>
        ))}
      </div>
    </aside>
  </div>
</Base>
