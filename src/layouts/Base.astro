---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const site = 'Mario Figueras';
const { title, description = 'Devlog: building NihonWorld and learning to work with AI agents, Jira and architecture, in the open.' } = Astro.props;
const fullTitle = title ? `${title} · ${site}` : `${site} · Devlog`;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Devlog' },
  { href: '/about/', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/"><span class="dot" aria-hidden="true"></span>Mario Figueras</a>
      <nav>
        {nav.map((n) => (
          <a href={n.href} aria-current={(n.href === '/' ? path === '/' : path.startsWith(n.href)) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Written by me, drafted with help from AI assistants. Every post is reviewed and approved by me before it goes up.</p>
      <p>
        <a href="https://github.com/MarioFigueras">GitHub</a> ·
        <a href="https://www.linkedin.com/in/mario-figueras" rel="me">LinkedIn</a>
      </p>
    </footer>
  </body>
</html>
