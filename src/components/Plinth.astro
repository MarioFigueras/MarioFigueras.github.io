---
import { Scene } from '../lib/iso';
interface Props { n: number; size?: 'sm' | 'lg' }
const { n, size = 'sm' } = Astro.props;
const label = String(n).padStart(2, '0');
// The entry number standing on a little plinth: a diorama base with nothing on it but the number.
const s = new Scene(size === 'lg' ? 40 : 20);
s.box(0, 0, 0, 2, 2, 0.7, 'f-paper s-ink', 'f-solid s-ink', 'f-solid2 s-ink');
const [tx, ty] = s.p(1, 1, 0.7);
const fs = size === 'lg' ? 78 : 34;
s.raw(
  `<text x="${tx + fs * 0.07}" y="${ty - fs * 0.05}" text-anchor="middle" class="t-zen f-pink" font-size="${fs}">${label}</text>` +
    `<text x="${tx}" y="${ty - fs * 0.13}" text-anchor="middle" class="t-zen f-blue blend" font-size="${fs}">${label}</text>`,
  [tx - fs * 0.75, ty - fs * 0.95],
  [tx + fs * 0.8, ty],
);
---
<span class={`plinth plinth-${size}`} aria-hidden="true" set:html={s.svg(`Entry ${label}`, 4)} />
